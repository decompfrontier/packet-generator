json GachaCategory {
    doc """
    Banner/category rows for the summon top screen.
    A category is the visible banner entry the player taps on. The client uses
    gatcha_id_list to decide which summon gates are available behind that
    banner. One category can point at one gate or multiple gates.
    """

    field id type="i32::str" {
        key "vx9uyQVQ"
        doc "Category id. Encoded as a string in the live data."
    }

    field img type="str" {
        key "In7lGGLn"
        doc "Banner image shown on the summon top/list screen."
    }

    field disp_order type="i32::int" {
        key "2r4EoNt4"
        doc "Display order of this banner category."
    }

    field gatcha_id_list type="str" {
        key "3rCmq58M"
        doc """
        Comma-separated summon gate ids opened by this banner.
        Example: "11960" shows one summon gate; "2000,2010,2020" creates one
        banner that can page through multiple summon gates.
        """
    }

    field start_date type="datetime-unix" {
        key "qA7M9EjP"
        doc """
        Category start time.
        The client actually checks this field (now needs to be > this),
        so we default to 0.
        """
    }

    field end_date type="datetime-unix" {
        key "SzV0Nps7"
        doc """
        Category end time.
        The client actually checks this field (now needs to be < this)
        and truncates it to signed 32-bit, so the safest maximum would
        be 2147483647 (which in unix time is around 2038).

        This also means that in roughly ~12 years, we would need to worry
        about manipulating the client's own clock so that it doesn't trip
        over itself truncating to an int32. 
        """
    }
}

json GachaMst {
    doc """
    Core summon gate MST rows from deploy/system/gacha.json.
    These rows define the actual summon gates by id: type, order, cost,
    open/close dates, images, and text. GachaCategory points at these ids to
    decide which gates a visible banner opens.
    """

    field id type="i32::str" {
        key "7Ffmi96v"
        doc "Summon gate id. This is the id referenced by gatcha_id_list."
    }

    field name type="str" {
        key "4N27mkt1"
        doc "Display/internal name for the summon gate."
    }

    field type type="i32::str" {
        key "S1oz60Hc"
        doc """
        Summon gate type.
        """
    }

    // TODO: an enum?
    field priority type="i32::str" {
        key "yu18xScw"
        doc "Gate ordering/priority used by the summon UI."
    }

    field start_date type="datetime" {
        key "qA7M9EjP"
        doc """
        Gate start time. Probably not used.
        """
    }

    // (2017-10-24 08:00:00)
    field end_date type="datetime" {
        key "SzV0Nps7"
        doc """
        Gate end time. Probably not used.
        """
    }

    // (2017-10-24 08:00:00)
    field start_hour type="str" {
        key "2HY3jpgu"
        doc "TODO"
    }

    field end_hour type="str" {
        key "v9TR3cDz"
        doc "TODO"
    }

    field need_friend_point type="i32::str" {
        key "J3stQ7jd"
        doc "Friend point cost for friend-point summon gates."
    }

    field need_gems type="i32::str" {
        key "03UGMHxF"
        doc "Gem cost shown/used for gem summon gates."
    }

    field once_day_flag type="bool::str" {
        key "4tswNoV9"
        doc "TODO"
    }

    field bg_img type="str" {
        key "1Dg0vUX3"
        doc "Summon gate detail/background image."
    }

    field btn_img type="str" {
        key "W9ABuJj2"
        doc "Summon button image for this gate."
    }

    field door_img type="str" {
        key "uKYf13AH"
        doc "Summon door/animation image for this gate."
    }

    field caption_msg type="str" {
        key "3sdHQb69"
        doc "Long formatted gate caption/body text."
    }

    field detail_msg type="str" {
        key "W2c9g0Je"
        doc "Formatted short/detail message shown by the summon gate UI."
    }

    field comment_msg type="str" {
        key "gVSj32QH"
        doc "TODO"
    }

    field gatcha_group_id type="i32::str" {
        key "TCnm1F4v"
        doc "TODO"
    }

    field description type="str" {
        key "qp37xTDh"
        doc "TODO"
    }

    field gatcha_detail_id type="str" {
        key "8Z9CYQDq"
        doc "TODO"
        optional #true
        // "default": DefaultType.Omit
    }

    field contents_banner_img type="str" {
        key "sA9dDAqB"
        doc "TODO"
        optional #true
        // "default": DefaultType.Omit
    }
}


json GachaInfoMst {
    doc """
    Supplemental summon gate display rows from deploy/system/gacha_info.json.
    The client relies on this to see which summon gates are actually available.
    The summon list request sends this alongside category data. It overlaps with
    GachaMst, and some fields must be consistent with its counterpart in GachaMst.
    """

    field id type="i32::str" {
        key "7Ffmi96v"
        doc """
        Summon gate id.
        Must match GachaMst.id and appear in GachaCategory.gatcha_id_list.
