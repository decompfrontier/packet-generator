json SummonTicketV2UserInfo {
    doc "User's owned-ticket entry in the V2 typed-ticket inventory.  Wire wrapper a3d5d12i (IDA: SummonTicketV2UserInfoResponse, is_array=true).  Per a private IDA readParam audit of the handler at 0x1C6EBB4, it reads TWO fields — `b0D2iq2d → setSummonTicketV2Id(std::string)` and `Rs7bCE3t → setAmount(int)` parsed via CommonUtils::StrToInt.  readparam_analysis.json only lists the first one; the audit confirmed the second comes through a hand-coded path inside the same readParam.  // REVERTED FROM single-field struct: earlier port (§7.10) dropped Rs7bCE3t guessing the wire-strict client rejected unknown fields.  Audit proves both fields are read; the shape that matters is one entry per ticket TYPE with `amount` carrying the owned count — not N entries per type."

    field id type="i32::str" {
        doc "Ticket-type id.  Setter: setSummonTicketV2Id(std::string) per audit.  Joins to SummonTicketV2Mst.id (b0D2iq2d).  Captured: \"8\" (Brave Summon Ticket → door 17160 / Veteran summon's Brave half), \"3\" (Anniversary 2017 Ticket → door 14420)."
        key "b0D2iq2d"
    }

    field amount type="i32::str" {
        doc "How many of this ticket type the user owns.  Setter: setAmount(int) via CommonUtils::StrToInt per audit — the wire ships a quoted string and the client parses to int.  Backing store: user_summon_tickets_v2.count.  Decremented by 1 per pull when GachaAction is invoked with `324b023k`=1 against an eligible door."
        key "Rs7bCE3t"
    }
}
