json UserPartyDeckInfo {
    doc "TODO"

    field user_unit_id type="i32::str" {
        key "edy7fq3L"
        doc "TODO"
    }

    field deck_type type="i32::str" {
        key "U9ABSYEp"
        doc "Deck slot kind, usually 1 (party). // CAPTURED FROM: deploy/log/http_log_m2Ve9PkJ_*.log DeckEdit request had \"U9ABSYEp\":\"1\" (quoted). // REVERTED FROM i32::int: that made glaze silently fail to parse the DeckEdit body, so the deck array was always empty and saves were dropped."
    }

    field deck_num type="i32::str" {
        key "zsiAn9P1"
        doc "Deck index within the slot (0-9). // CAPTURED FROM: deploy/log/http_log_m2Ve9PkJ_*.log DeckEdit request had \"zsiAn9P1\":\"0\" (quoted). // REVERTED FROM i32::int: same silent-parse-fail story as deck_type."
    }

    field member_type type="i32::str" {
        key "gr48vsdJ"
        doc "TODO"
    }

    field disp_order type="i32::str" {
        key "XuJL4pc5"
        doc "TODO"
    }

}

