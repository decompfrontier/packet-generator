json UserClearMissionInfo {
	doc "UserClearMissionInfoResponse (wire key UT1SVg59). Per-mission clear-history record carried in the MissionEnd response so the client can keep its mission-clear list synced. ALL 7 fields decoded from UserClearMissionInfo::readParam in libgame.so via a private IDA audit. Every field uses std::string-typed setters even when the value is numeric (clear count, BC/HC totals) — BF stores them as quoted strings on the wire."

	field user_id type=str {
		key "h7eY3sAK"
		doc "setUserID. The player's user_id (not a friend / reinforce id)."
	}

	field mission_id type=str {
		key "j28VNcUW"
		doc "setMissionID. The mission this record is for. Combined with user_id forms the unique key (one row per (user, mission))."
	}

	field clear_date type=str {
		key "JATWnN57"
		doc "setClearDate. Timestamp of the most recent clear. Format // UNVERIFIED — likely either Unix epoch as a quoted int or the BF datetime string `YYYY-MM-DD HH:MM:SS`."
	}

	field clear_cnt type=str {
		key "HIQoGb10"
		doc "setClearCnt. How many times the player has cleared this mission. Stored as a quoted string on the wire (\"1\", \"2\", ...). Server has no per-mission clear counter yet — currently sent as \"1\" placeholder."
	}

	field most_time type=str {
		key "Wi4EFe6f"
		doc "setMostTime. Fastest clear time the player has ever recorded for this mission. Format // UNVERIFIED — likely seconds as quoted int (\"42\") or m:ss formatted string. Server has no per-mission best-time tracking yet — sent as empty string."
	}

	field get_bc type=str {
		key "RWX38boG"
		doc "setGetBc. Lifetime Battle Crystal count obtained from THIS specific mission across all clears. Quoted-int wire format. Server has no per-mission BC ledger yet — sent as \"0\" placeholder."
	}

	field get_hc type=str {
		key "bGx5ku0F"
		doc "setGetHc. Lifetime Heart Crystal count obtained from THIS specific mission. Same shape as get_bc."
	}
}

