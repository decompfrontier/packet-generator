// Network types for the MissionStart / MissionEnd / MissionBreak handler trio.
//
// Sources: captured deploy/log/http_log_jE6Sp0q4_*.log (MissionStart) and
// http_log_9TvyNR5H_*.log (MissionEnd); IDA dumps in
// "BraveFrontier IDA readParam and Handler exports and scripts"
// (readparam_analysis.json + response_mappings.json + typed_responses);
// F_MISSION_MST_1_Ver1118.json for the server-side mission table (already
// covered by mst/mission.kdl).
//
// Audit caveats:
// 1. response_mappings.json lists 5 keys for MissionStartInfoResponse but
//    the typed readParam helper covers only 4. 1VagK32J is reached via a
//    hand-coded getValue() path (handbook section 3.2).
// 2. Most rXvA1E5y / 0xgIw1Ns / Kz7qfSs5 fields have no readparam setter
//    (these are request-only structs the client builds in createBody;
//    binary-side parsing not exported). Types are inferred from observed
//    wire values; every undocumented field is marked UNVERIFIED.

// =============================================================================
//  MissionStart  (group jE6Sp0q4, aes csiVLDKkxEwBfR70)
// =============================================================================

json MissionStartReqItem {
    doc "Inner item in MissionStart 9Q1Lq5FS array. Only mission_id and active_deck are server-meaningful; the other 6 are tutorial/event flags the server acknowledges but does not act on."

    field user_id type=str {
        key "h7eY3sAK"
        doc "Always \"0\" in captured player requests. Distinct from IKqx1Cn9.h7eY3sAK (real user UUID). // UNVERIFIED purpose."
    }

    field unk_J3stQ7jd type="i32::str" {
        key "J3stQ7jd"
        doc "Always \"0\" in captured requests. // UNVERIFIED."
    }

    field mission_id type="i32::str" {
        key "j28VNcUW"
        doc "Mission ID being started. Cross-refs F_MISSION_MST.id (see MissionMst in mst/mission.kdl). Quoted on wire."
    }

    field unk_jkldTrhL type="i32::str" {
        key "jkldTrhL"
        doc "Always \"0\" in captured requests. // UNVERIFIED."
    }

    field active_deck type="i32::str" {
        key "Z0Y4RoD7"
        doc "Squad/deck index 0-9 the player selected. Server UPDATEs userinfo.active_deck. IDA setter (other response classes): ActiveGuildDeck."
    }

    field unk_nA95Bdj6 type="i32::str" {
        key "nA95Bdj6"
        doc "Always \"0\" in captured requests. // UNVERIFIED."
    }

    field unk_5Z1LNoyH type="i32::str" {
        key "5Z1LNoyH"
        doc "Always \"0\" in captured requests. // UNVERIFIED."
    }

    field unk_u1iPEVUq type="i32::str" {
        key "u1iPEVUq"
        doc "Always \"-1\" in captured requests. Sentinel/disabled. // UNVERIFIED."
    }
}

json MissionStartReqJzS {
    doc "Inner item in MissionStart JzS3uxsZ array. Single field seen in every capture. // UNVERIFIED purpose."

    field unk_0b4efi1W type="i32::str" {
        key "0b4efi1W"
        doc "Always \"1\" in captured requests. // UNVERIFIED."
    }
}

json MissionStartInfo {
    doc "fEi17cnx[1] sub-element in MissionStart response. Hash key 9Q1Lq5FS per response_mappings MissionStartInfoResponse. All 5 fields decoded from MissionStartInfo::readParam in libgame.so via a private IDA audit of the handler at func_addr 0x13E46D0."

    field reinforce_user_id type=str {
        key "h7eY3sAK"
        doc "setReinforceUserID. Reinforcement friend user_id. Captured live data: \"n9ZMPC0t\". Currently hardcoded pending friend system. Per the IDA setter, this is specifically the REINFORCE user_id (not the player's own h7eY3sAK)."
    }

    field friend_point type="i32::str" {
        key "J3stQ7jd"
        doc "setFriendPoint. Friend point count for the reinforce slot. Previously misidentified as 'account_id' (5-digit value 42640 in captures) — actually friend-point quantity that the player would pay to use the friend's reinforce."
    }

    field mission_id type="i32::str" {
        key "j28VNcUW"
        doc "setMissionID. Echoes the request mission_id. Bug history: echoing wrong value crashed client on second mission load (handbook section 7.4.1)."
    }

    field reinforce_info type=str {
        key "1VagK32J"
        doc "setReinforceInfo. Free-form string blob carrying reinforce metadata (presumably serialized unit/skill snapshot — captured idle value: empty). Previously sent as 0 / omitted; client appears to tolerate empty. Reachable via hand-coded getValue() path so the readparam_analysis.json typed dump didn't list it (handbook section 3.2)."
    }

    field deck_num type="i32::str" {
        key "Z0Y4RoD7"
        doc "setDeckNum. Deck number used for this mission (0-9). Echoes Z0Y4RoD7 from the request 9Q1Lq5FS[0]. Note this is per-MissionStartInfo (the [1] sub-block); UserTeamInfo at [0] has the same wire key Z0Y4RoD7 mapped to a different setter (setActiveDeck / setActiveGuildDeck per other readparam classes) — same key, different semantic in different response contexts."
    }
}

// =============================================================================
//  MissionEnd  (group 9TvyNR5H, aes oINq0rfUFPx5MgmT)
// =============================================================================

json MissionEndReqBattleResult {
    doc "Inner item in MissionEnd rXvA1E5y array. 41 fields per captured request. Most are integer counters with no readparam coverage; only BattleCrystalNum, HeartCrystalNum, MaxTurnDamage have IDA setter names. Inferred type i32::str for all (every observed value parses as quoted integer)."

    field earn_zel type="i32::str" {
        key "Najhr8m6"
        doc "Zel earned this battle. Same key as userinfo.zel but here the value is the DELTA. Captured: \"182\"."
    }

    field earn_karma type="i32::str" {
        key "HTVh8a65"
        doc "Karma earned this battle. Captured: \"106\"."
    }

    field item_drops type=str {
        key "4T0Q2Bh5"
        doc "Item drops, comma-separated item_id:count pairs. Captured: \"10300:9,10000:10,10301:2\". Kept as str (inner-pair shape does not fit [i32::str]::sep(comma), see handbook section 3.3)."
